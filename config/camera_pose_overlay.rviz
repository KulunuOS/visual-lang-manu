Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Marker Scale: 0.08
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: RTAB-Map Cloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /rtabmap/cloud_map
      Value: true
      Size (Pixels): 2
      Style: Points
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Input Point Cloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/depth/color/points
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Bonn GT-Frame Point Cloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /visual_grasp_manu/bonn/points_gt_map
      Value: true
      Size (Pixels): 2
      Style: Points
    - Class: rviz_default_plugins/Path
      Enabled: true
      Color: 0; 255; 38
      Name: Inferred Camera Path
      Line Style: Lines
      Line Width: 0.015
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visual_grasp_manu/inferred_camera_path
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: GT Camera Path
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visual_grasp_manu/gt_camera_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Camera Pose Markers
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visual_grasp_manu/camera_pose_markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 38; 38; 38
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.2
      Name: Current View
      Pitch: 0.6
      Target Frame: map
      Yaw: 0.8
