Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Marker Scale: 0.05
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Live RGB-D Cloud
      Decay Time: 2
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /visual_grasp_manu/live/rgbd_cloud
      Value: true
      Size (Pixels): 3
      Style: Points
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Accepted Mask Cloud
      Decay Time: 4
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /visual_grasp_manu/mask_overlay/cloud
      Value: true
      Size (Pixels): 5
      Style: Points
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Initial Camera Frustum
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visual_grasp_manu/initial_camera_frustum
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Live Mask Overlay
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visual_grasp_manu/mask_overlay/markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Generated Object Mesh
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visual_grasp_manu/object_mesh_marker
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Mask Overlay Image
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /visual_grasp_manu/mask_overlay/image
      Value: true
  Enabled: true
  Global Options:
    Background Color: 38; 38; 38
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.4
      Name: Current View
      Pitch: 0.55
      Target Frame: odom
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
  X: 40
  Y: 40
  QMainWindow State: 000000ff00000000fd0000000100000000000005780000031dfc0200000001fb000000100044006900730070006c006100790073010000003d0000031d000000c900ffffff000005780000031d00000004000000040000000800000008fc0000000100000002000000010000000a0054006f006f006c00730100000000ffffffff0000000000000000
