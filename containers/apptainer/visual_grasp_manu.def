Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

%labels
    Author visual_grasp_manu
    Description ROS 2 Humble, Open3D, and Python vision base for visual grasp mesh generation experiments

%environment
    export ROS_DISTRO=humble
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PIP_DISABLE_PIP_VERSION_CHECK=1
    export PYTHONDONTWRITEBYTECODE=1

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        gnupg \
        lsb-release \
        locales \
        ninja-build \
        python3-dev \
        python3-pip \
        software-properties-common \
        wget

    locale-gen en_US en_US.UTF-8
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8

    add-apt-repository universe
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
        > /etc/apt/sources.list.d/ros2.list

    apt-get update
    apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libopencv-dev \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-vcstool \
        ros-humble-desktop \
        ros-humble-rtabmap-ros \
        ros-humble-rviz2

    python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel
    python3 -m pip install --no-cache-dir \
        numpy \
        open3d \
        opencv-python-headless \
        pillow \
        pyyaml \
        scipy \
        tqdm

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /bin/bash "$@"

%help
    Build:
      apptainer build visual_grasp_manu.sif containers/apptainer/visual_grasp_manu.def

    Run with NVIDIA GPU pass-through:
      apptainer shell --nv --bind "$PWD":/workspace/visual_grasp_manu visual_grasp_manu.sif

    Inside the container:
      cd /workspace/visual_grasp_manu
      source /opt/ros/humble/setup.bash
      colcon build
      source /tmp/visual_grasp_manu/install/setup.bash
